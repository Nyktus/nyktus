* text=auto eol=lf

*.png   binary
*.jpg   binary
*.ico   binary
*.woff2 binary

# Mail ends lines in CRLF; the golden files of messages keep them.
internal/platform/smtp/testdata/*.golden -text
go.sum            linguist-generated
package-lock.json linguist-generated
internal/attack/techniques.json linguist-generated
docs/public/deception-catalog.json linguist-generated

# Files of the catalog are shipped as they are, with the line endings that
# their tools expect, such as CRLF for PowerShell scripts.
catalog/deceptions/*/files/* -text
