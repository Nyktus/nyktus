$ErrorActionPreference = 'Stop'
Import-Module ActiveDirectory
$bytes = New-Object byte[] 48
$generator = [System.Security.Cryptography.RandomNumberGenerator]::Create()
$generator.GetBytes($bytes)
$generator.Dispose()
$plain = [Convert]::ToBase64String($bytes) + 'aA1!'
$password = ConvertTo-SecureString $plain -AsPlainText -Force
New-ADUser -Name '{{.Persona.ServiceAccount}}' -SamAccountName '{{.Persona.ServiceAccount}}' -UserPrincipalName '{{.Persona.ServiceAccount}}@{{.Persona.Domain}}' -AccountPassword $password -Enabled $true -PasswordNeverExpires $true -ServicePrincipalNames 'MSSQLSvc/{{.Persona.ServiceHost}}:1433'
