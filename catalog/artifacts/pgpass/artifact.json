{
  "schema_version": 1,
  "id": "pgpass",
  "category": "application",
  "title": {
    "en": "PostgreSQL password file",
    "de": "PostgreSQL-Passwortdatei"
  },
  "summary": {
    "en": "A .pgpass file with the host, database, account and password of a PostgreSQL server, as libpq reads it. Connecting resolves the name of a DNS honeytoken.",
    "de": "Eine .pgpass-Datei mit Host, Datenbank, Konto und Passwort eines PostgreSQL-Servers, wie libpq sie liest. Wer sich verbindet, löst den Namen eines DNS-Honeytokens auf."
  },
  "slots": [
    {"key": "Database", "accepts": ["dns"], "optional": false}
  ],
  "persona": [
    {
      "key": "DatabaseName",
      "kind": "name",
      "label": {"en": "Name of the database", "de": "Name der Datenbank"},
      "example": "billing"
    },
    {
      "key": "Account",
      "kind": "name",
      "label": {"en": "Database account", "de": "Datenbankkonto"},
      "example": "billing_app"
    }
  ],
  "secrets": [
    {"key": "Password", "length": 20}
  ],
  "file_name": "pgpass",
  "format": "config",
  "line_endings": "lf",
  "template": "pgpass.tmpl",
  "placing": {"en": "placing.en.md.tmpl", "de": "placing.de.md.tmpl"}
}
