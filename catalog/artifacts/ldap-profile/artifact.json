{
  "schema_version": 1,
  "id": "ldap-profile",
  "category": "network",
  "title": {
    "en": "Connection profile for a directory",
    "de": "Verbindungsprofil für ein Verzeichnis"
  },
  "summary": {
    "en": "A profile of an application for its LDAP directory, with a bind account and password. Connecting resolves the name of a DNS honeytoken.",
    "de": "Ein Profil einer Anwendung für ihr LDAP-Verzeichnis, mit Bind-Konto und Passwort. Wer sich verbindet, löst den Namen eines DNS-Honeytokens auf."
  },
  "slots": [
    {"key": "Directory", "accepts": ["dns"], "optional": false}
  ],
  "persona": [
    {
      "key": "Domain",
      "kind": "host",
      "label": {"en": "Internal domain", "de": "Interne Domain"},
      "example": "corp.example.com"
    },
    {
      "key": "Account",
      "kind": "name",
      "label": {"en": "Bind account", "de": "Bind-Konto"},
      "example": "svc-ldap"
    }
  ],
  "secrets": [
    {"key": "Password", "length": 20}
  ],
  "file_name": "ldap.ini",
  "format": "config",
  "line_endings": "lf",
  "template": "ldap.ini.tmpl"
}
