{
  "schema_version": 1,
  "id": "mongodb-backup-beacon",
  "category": "data",
  "title": {
    "en": "MongoDB document with a connection string",
    "de": "MongoDB-Dokument mit Verbindungszeichenfolge"
  },
  "summary": {
    "en": "A mongosh script that stores a document with a connection string in your database. Every backup carries it; whoever uses the string resolves the name of a DNS honeytoken.",
    "de": "Ein mongosh-Skript, das ein Dokument mit einer Verbindungszeichenfolge in Ihrer Datenbank ablegt. Jede Sicherung trägt es; wer die Zeichenfolge nutzt, löst den Namen eines DNS-Honeytokens auf."
  },
  "engage_activities": ["EAC0011"],
  "slots": [
    {"key": "Database", "accepts": ["dns"], "optional": false}
  ],
  "persona": [
    {
      "key": "DatabaseName",
      "kind": "name",
      "label": {"en": "Name of the database", "de": "Name der Datenbank"},
      "example": "integrations"
    },
    {
      "key": "CollectionName",
      "kind": "name",
      "label": {"en": "Name of the collection", "de": "Name der Collection"},
      "example": "endpoints"
    },
    {
      "key": "ServiceName",
      "kind": "name",
      "label": {"en": "Name of the service", "de": "Name des Dienstes"},
      "example": "sync-service"
    },
    {
      "key": "Account",
      "kind": "name",
      "label": {"en": "Account", "de": "Konto"},
      "example": "svc-sync"
    }
  ],
  "secrets": [
    {"key": "Password", "length": 20}
  ],
  "file_name": "endpoints.js",
  "format": "config",
  "line_endings": "lf",
  "template": "endpoints.js.tmpl"
}
