{
  "schema_version": 1,
  "id": "kubeconfig",
  "category": "application",
  "title": {
    "en": "Kubernetes configuration with a token",
    "de": "Kubernetes-Konfiguration mit Token"
  },
  "summary": {
    "en": "A kubectl configuration for a cluster with a bearer token. Every kubectl call resolves the name of a DNS honeytoken.",
    "de": "Eine kubectl-Konfiguration für einen Cluster mit Bearer-Token. Jeder kubectl-Aufruf löst den Namen eines DNS-Honeytokens auf."
  },
  "slots": [
    {"key": "Api", "accepts": ["dns"], "optional": false}
  ],
  "persona": [
    {
      "key": "Cluster",
      "kind": "name",
      "label": {"en": "Name of the cluster", "de": "Name des Clusters"},
      "example": "prod-eu1"
    },
    {
      "key": "Account",
      "kind": "name",
      "label": {"en": "Account", "de": "Konto"},
      "example": "deploy"
    }
  ],
  "secrets": [
    {"key": "Token", "length": 40}
  ],
  "file_name": "config",
  "format": "config",
  "line_endings": "lf",
  "template": "config.tmpl"
}
