{
  "schema_version": 1,
  "id": "adcs-template-catalog-catalog",
  "category": "identity",
  "title": {
    "en": "Page listing certificate templates",
    "de": "Seite mit Zertifikatvorlagen"
  },
  "summary": {
    "en": "An internal page that lists the certificate templates of a certification authority and links to the enrollment.",
    "de": "Eine interne Seite, die die Zertifikatvorlagen einer Zertifizierungsstelle auflistet und auf die Anforderung verweist."
  },
  "slots": [
    {"key": "Enrollment", "accepts": ["web_url"], "optional": false}
  ],
  "persona": [
    {
      "key": "Company",
      "kind": "text",
      "label": {"en": "Name of the organization", "de": "Name der Organisation"},
      "example": "Example Corp"
    },
    {
      "key": "Authority",
      "kind": "text",
      "label": {"en": "Name of the certification authority", "de": "Name der Zertifizierungsstelle"},
      "example": "Example Issuing CA 01"
    }
  ],
  "secrets": [],
  "file_name": "Certificate-templates.html",
  "format": "html",
  "line_endings": "lf",
  "template": "certificate-templates.html.tmpl"
}
