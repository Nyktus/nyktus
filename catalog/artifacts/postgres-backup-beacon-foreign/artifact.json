{
  "schema_version": 1,
  "id": "postgres-backup-beacon-foreign",
  "category": "data",
  "title": {
    "en": "PostgreSQL foreign table",
    "de": "PostgreSQL-Fremdtabelle"
  },
  "summary": {
    "en": "SQL for a foreign table of your PostgreSQL database through postgres_fdw. Every query of the table resolves the name of a DNS honeytoken.",
    "de": "SQL für eine Fremdtabelle Ihrer PostgreSQL-Datenbank über postgres_fdw. Jede Abfrage der Tabelle löst den Namen eines DNS-Honeytokens auf."
  },
  "slots": [
    {"key": "Database", "accepts": ["dns"], "optional": false}
  ],
  "persona": [
    {
      "key": "ServerName",
      "kind": "name",
      "label": {"en": "Name of the foreign server", "de": "Name des Fremdservers"},
      "example": "reporting_replica"
    },
    {
      "key": "TableName",
      "kind": "name",
      "label": {"en": "Name of the foreign table", "de": "Name der Fremdtabelle"},
      "example": "customer_payment_tokens"
    },
    {
      "key": "DatabaseName",
      "kind": "name",
      "label": {"en": "Name of the remote database", "de": "Name der entfernten Datenbank"},
      "example": "analytics"
    },
    {
      "key": "Account",
      "kind": "name",
      "label": {"en": "Remote account", "de": "Entferntes Konto"},
      "example": "bi_reader"
    }
  ],
  "secrets": [
    {"key": "Password", "length": 20}
  ],
  "file_name": "foreign-table.sql",
  "format": "config",
  "line_endings": "lf",
  "template": "foreign-table.sql.tmpl"
}
