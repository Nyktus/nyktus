{
  "schema_version": 1,
  "id": "replication-runbook",
  "category": "network",
  "title": {
    "en": "Runbook for checking replication",
    "de": "Runbook zur Prüfung der Replikation"
  },
  "summary": {
    "en": "A runbook that names a domain controller for the replication check. Querying that controller resolves the name of a DNS honeytoken.",
    "de": "Ein Runbook, das einen Domänencontroller für die Replikationsprüfung nennt. Wer diesen Controller abfragt, löst den Namen eines DNS-Honeytokens auf."
  },
  "slots": [
    {"key": "Controller", "accepts": ["dns"], "optional": false}
  ],
  "persona": [
    {
      "key": "Domain",
      "kind": "host",
      "label": {"en": "Internal domain", "de": "Interne Domain"},
      "example": "corp.example.com"
    },
    {
      "key": "Contact",
      "kind": "text",
      "label": {"en": "Contact", "de": "Ansprechpartner"},
      "example": "Infrastructure team"
    }
  ],
  "secrets": [],
  "file_name": "Replication-check.txt",
  "format": "text",
  "line_endings": "lf",
  "template": "replication-check.txt.tmpl"
}
