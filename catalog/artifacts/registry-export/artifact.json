{
  "schema_version": 1,
  "id": "registry-export",
  "category": "endpoint",
  "title": {
    "en": "Registry export with backup settings",
    "de": "Registry-Export mit Sicherungseinstellungen"
  },
  "summary": {
    "en": "A .reg file with the server, account and password of a backup tool. Connecting to the server resolves the name of a DNS honeytoken.",
    "de": "Eine .reg-Datei mit Server, Konto und Passwort eines Sicherungsprogramms. Wer sich mit dem Server verbindet, löst den Namen eines DNS-Honeytokens auf."
  },
  "slots": [
    {"key": "Server", "accepts": ["dns"], "optional": false}
  ],
  "persona": [
    {
      "key": "Vendor",
      "kind": "name",
      "label": {"en": "Name of the backup software", "de": "Name der Sicherungssoftware"},
      "example": "BackupPro"
    },
    {
      "key": "Account",
      "kind": "name",
      "label": {"en": "Account", "de": "Konto"},
      "example": "svc-backup"
    }
  ],
  "secrets": [
    {"key": "Password", "length": 20}
  ],
  "file_name": "Settings.reg",
  "format": "config",
  "line_endings": "crlf",
  "template": "settings.reg.tmpl"
}
