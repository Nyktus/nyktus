{
  "schema_version": 1,
  "id": "my-cnf",
  "category": "application",
  "title": {
    "en": "MySQL client configuration",
    "de": "MySQL-Client-Konfiguration"
  },
  "summary": {
    "en": "A my.cnf file with the host, account and password in the client group, as the MySQL clients read it. Connecting resolves the name of a DNS honeytoken.",
    "de": "Eine my.cnf-Datei mit Host, Konto und Passwort in der Gruppe client, wie die MySQL-Clients sie lesen. Wer sich verbindet, löst den Namen eines DNS-Honeytokens auf."
  },
  "slots": [
    {"key": "Database", "accepts": ["dns"], "optional": false}
  ],
  "persona": [
    {
      "key": "DatabaseName",
      "kind": "name",
      "label": {"en": "Name of the database", "de": "Name der Datenbank"},
      "example": "billing"
    },
    {
      "key": "Account",
      "kind": "name",
      "label": {"en": "Database account", "de": "Datenbankkonto"},
      "example": "billing_app"
    }
  ],
  "secrets": [
    {"key": "Password", "length": 20}
  ],
  "file_name": "my.cnf",
  "format": "config",
  "line_endings": "lf",
  "template": "my.cnf.tmpl",
  "placing": {"en": "placing.en.md.tmpl", "de": "placing.de.md.tmpl"}
}
