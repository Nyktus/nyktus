CREATE EXTENSION IF NOT EXISTS dblink WITH SCHEMA public;

CREATE FUNCTION public."{{.Persona.FunctionName}}"() RETURNS integer
LANGUAGE plpgsql AS $body$
BEGIN
  BEGIN
    PERFORM public.dblink_connect('{{.Persona.FunctionName}}', 'host={{.Honeytokens.Database.Host}} port=5432 dbname={{.Persona.DatabaseName}} user={{.Persona.Account}} password={{.Secrets.Password}} connect_timeout=3');
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
  RETURN 1;
END;
$body$;

CREATE MATERIALIZED VIEW public."{{.Persona.ViewName}}" AS
  SELECT public."{{.Persona.FunctionName}}"() AS refreshed;
