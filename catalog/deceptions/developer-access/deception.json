      "severity": "high"
    },
    {
      "key": "Git",
      "type": "dns",
      "label": {"en": "Git server", "de": "Git-Server"},
      "techniques": ["T1552.001", "T1213.003"],
      "severity": "high"
    },
    {
      "key": "Registry",
      "type": "dns",
      "label": {"en": "Package registry", "de": "Paket-Registry"},
      "techniques": ["T1552.001", "T1195.001"],
      "severity": "high"
    }
  ],
  "persona": [
    {
      "key": "Product",
      "kind": "text",
      "label": {"en": "Name of the internal service", "de": "Name des internen Dienstes"},
      "example": "Inventory service"
    },
    {
      "key": "Account",
      "kind": "name",
      "label": {"en": "Account", "de": "Konto"},
      "example": "ci-pull"
    },
    {
      "key": "Project",
      "kind": "name",
      "label": {"en": "Name of the project", "de": "Name des Projekts"},
      "example": "platform-prod"
    }
  ],
  "artifacts": ["api-key-snippet", "git-credentials", "git-config", "npmrc", "pip-conf", "project-readme"],
  "guide": {"en": "guide.en.md.tmpl", "de": "guide.de.md.tmpl"}
}
