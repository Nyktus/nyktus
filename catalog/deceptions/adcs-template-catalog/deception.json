    {
      "key": "Authority",
      "kind": "text",
      "label": {"en": "Name of the certification authority", "de": "Name der Zertifizierungsstelle"},
      "example": "Example Issuing CA 01"
    }
  ],
  "artifacts": ["adcs-template-catalog-catalog", "adcs-template-catalog-bookmark"],
  "guide": {"en": "guide.en.md.tmpl", "de": "guide.de.md.tmpl"}
}
