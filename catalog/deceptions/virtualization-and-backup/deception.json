    },
    {
      "key": "Repository",
      "type": "dns",
      "label": {"en": "Repository server", "de": "Repository-Server"},
      "techniques": ["T1490", "T1552.001"],
      "severity": "critical"
    }
  ],
  "persona": [
    {
      "key": "SsoDomain",
      "kind": "host",
      "label": {"en": "Single sign-on domain", "de": "Single-Sign-on-Domain"},
