    },
    {
      "key": "Account",
      "kind": "name",
      "label": {"en": "Service account", "de": "Dienstkonto"},
      "example": "svc-vmops"
    },
    {
      "key": "Netbios",
      "kind": "name",
      "label": {"en": "NetBIOS name of the domain", "de": "NetBIOS-Name der Domain"},
      "example": "CORP"
    },
    {
      "key": "Contact",
      "kind": "text",
      "label": {"en": "Contact", "de": "Ansprechpartner"},
      "example": "Backup team"
    }
