# Settings of the reference installation. Copy this file to ".env" in this
# directory, fill in the empty values and read README.md.
#
# Keep ".env" readable by its administrator only: it holds the passwords and the
# encryption key, and "docker inspect" shows them to anyone who may run it.

# --- Images -----------------------------------------------------------------

# The version to run. After "cosign verify", write the digest of the image behind
# it into the tag of your own copy of the compose file.
# x-release-please-start-version
NYKTUS_VERSION=0.3.0
# x-release-please-end

# --- Addresses --------------------------------------------------------------

# The address users open in the browser, with the host name alone again for the
# proxy. NYKTUS_CONSOLE_URL must be exactly what the browser shows.
NYKTUS_CONSOLE_URL=https://nyktus.example.com
NYKTUS_CONSOLE_HOST=nyktus.example.com

# The address of the trigger, which is what an intruder sees in the URL of a
# honeytoken. Its host name must differ from that of the console.
NYKTUS_TRIGGER_URL=https://t.example.net
NYKTUS_TRIGGER_HOST=t.example.net

# Where the trigger sends everyone that it does not send to the target of a
# honeytoken: a public page outside Nyktus, not on the host of the trigger or of
# the console.
NYKTUS_TRIGGER_DEFAULT_REDIRECT=https://www.example.com/

# --- Published ports --------------------------------------------------------

# The interface of the proxy of the console. The console belongs in an internal
# network: use the internal address of this host, and leave the loopback
# address if a proxy of your own or an SSH tunnel is in front.
NYKTUS_CONSOLE_BIND=127.0.0.1
# Other host ports than 80 and 443, if you need them:
# NYKTUS_CONSOLE_HTTP_PORT=80
# NYKTUS_CONSOLE_HTTPS_PORT=443

# The trigger on its own port, for a proxy of your own. Leave the loopback
# address when you use the profile "trigger-proxy".
NYKTUS_TRIGGER_BIND=127.0.0.1
# NYKTUS_TRIGGER_PORT=8081

# The interface of the proxy of the trigger (profile "trigger-proxy"), an
# address of this host that the internet reaches and that the proxy of the
# console does not use.
NYKTUS_TRIGGER_PROXY_BIND=203.0.113.10
# NYKTUS_TRIGGER_PROXY_HTTP_PORT=80
# NYKTUS_TRIGGER_PROXY_HTTPS_PORT=443

# The interface of the DNS role (profile "dns").
NYKTUS_DNS_BIND=0.0.0.0

# --- DNS honeytokens (profile "dns") ----------------------------------------

NYKTUS_DNS_ZONES=d.example.net
NYKTUS_DNS_NAMESERVERS=ns1.example.net
NYKTUS_DNS_ANSWER_IPV4=203.0.113.80

# --- Profiles ---------------------------------------------------------------

# "trigger-proxy" starts the nginx for the trigger, "dns" the DNS role.
COMPOSE_PROFILES=

# --- Secrets ----------------------------------------------------------------

# Encryption key for the secrets that Nyktus stores. Generate it once and keep a
# copy elsewhere: without it, the stored secrets are lost.
#   echo "1:$(openssl rand -base64 32)"
NYKTUS_ENCRYPTION_KEYS=

# Passwords of the database. Use letters and digits only, so that they stand in a
# URL as they are, for example:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
NYKTUS_OWNER_DB_PASSWORD=
NYKTUS_CONSOLE_DB_PASSWORD=
NYKTUS_TRIGGER_DB_PASSWORD=
NYKTUS_DNS_DB_PASSWORD=
NYKTUS_WORKER_DB_PASSWORD=
