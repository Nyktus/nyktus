# Release image of the sensor, built like the image of the server, see
# Dockerfile. The configuration file, the secrets and the host key are mounted
# into the container; none of them belongs in the image.

FROM gcr.io/distroless/static:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329

ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/nyktus-sensor /usr/local/bin/nyktus-sensor
COPY LICENSE NOTICE sensor/THIRD-PARTY-NOTICES.md /licenses/

USER 65532:65532

ENTRYPOINT ["/usr/local/bin/nyktus-sensor"]
CMD ["run", "-config", "/etc/nyktus-sensor/sensor.yaml"]
